# AI Translator Environment Configuration

# AI Provider Configuration
# Options: openai, deepseek, siliconflow, custom
AI_PROVIDER=deepseek
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# DeepSeek Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# SiliconFlow Configuration
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Custom API Configuration
CUSTOM_API_KEY=your-custom-api-key
CUSTOM_BASE_URL=https://your-api-endpoint.com/v1
CUSTOM_MODEL=your-model-name

# Database Configuration - MySQL
# 方式一：直接写 DATABASE_URL（密码若含 #@: 等需做 URL 编码）
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/aitranslator?charset=utf8mb4
# 方式二（推荐）：用下面 5 个变量，密码含特殊字符也可直接填写
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aitranslator

# 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Application Configuration
APP_NAME=AI Translator
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# CORS（留空则使用默认：localhost + 127.0.0.1 的 5173/8000）
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
