# AI Translator Environment Configuration

# AI Provider Configuration
# Options: openai, deepseek, siliconflow, custom
AI_PROVIDER=deepseek
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# DeepSeek Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# SiliconFlow Configuration
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Custom API Configuration
CUSTOM_API_KEY=your-custom-api-key
CUSTOM_BASE_URL=https://your-api-endpoint.com/v1
CUSTOM_MODEL=your-model-name

# Database Configuration
# SQLite (default for development)
DATABASE_URL=sqlite:///./translator.db
# MySQL (for production)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/translator?charset=utf8mb4

# Application Configuration
APP_NAME=AI Translator
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
