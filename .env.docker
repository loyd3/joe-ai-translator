# ============================================
# Joe AI Translator - Docker 环境配置示例
# 用法: copy .env.docker .env  后填入 AI Key
# 或直接双击 deploy.bat（无 .env 时会自动复制）
# ============================================

# AI Provider: openai, deepseek, siliconflow, ollama, custom
AI_PROVIDER=deepseek
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（可选）
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4

# SiliconFlow（可选）
# SILICONFLOW_API_KEY=your-siliconflow-api-key
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Ollama（本机模型；容器内访问宿主机请用 host.docker.internal）
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.2

# Custom（可选）
# CUSTOM_API_KEY=your-custom-api-key
# CUSTOM_BASE_URL=https://your-api-endpoint.com/v1
# CUSTOM_MODEL=your-model-name

# ============================================
# Docker MySQL（compose 内服务名 mysql，宿主机端口 3308）
# ============================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=aitranslator
MYSQL_USER=aitranslator
MYSQL_PASSWORD=aitranslator123
MYSQL_DATA_PATH=F:/docker-data/joe-ai-translator/mysql

# ============================================
# 应用配置
# ============================================
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false
APP_NAME=AI Translator
APP_VERSION=1.0.0
